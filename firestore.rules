rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // E-mail verificado: sem isso, a identidade do admin e so o e-mail que a
    // conta declara, e quem criasse por conta propria uma conta com um e-mail
    // listado em admins herdaria o acesso (auditoria de 16/10/2026, SEG-03).
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.ativo == true;
    }

    // Cada conta le so o proprio documento (o painel confere se esta ativa) e
    // ninguem grava pelo navegador: admins sao cadastrados pelo console ou pelo
    // Admin SDK. Antes, qualquer admin logado podia criar outro admin ou se
    // reativar (auditoria de 16/10/2026, SEG-01).
    match /admins/{adminEmail} {
      allow get: if isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == adminEmail;
      allow list, write: if false;
    }

    // Agendamentos, vagas, indices de CPF e bloqueios so mudam pelas Functions,
    // em transacao (auditoria de 16/10/2026, SEG-02). O painel le, e toda
    // escrita passa por callable com assertAdmin e log no servidor. Escrita
    // direta do navegador era o que permitia vender a mesma vaga duas vezes
    // (remarcacao) e forjar ou omitir a trilha de auditoria.
    match /vagas_ocupadas/{slotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dados_cidadaos/{documentId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    match /cpfs_agendados/{documentId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    match /bloqueios_agendamento/{cpf} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    match /cancelamentos_pendentes/{documentId} {
      allow read, write: if false;
    }

    match /operacoes_agendamento/{documentId} {
      allow read, write: if false;
    }

    // O painel ainda registra acoes que so acontecem no navegador (comprovante,
    // WhatsApp, exportacao). O log precisa levar o e-mail do proprio token e a
    // hora do servidor: antes qualquer admin podia gravar em nome de outro.
    match /logs_admin/{documentId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminEmail == request.auth.token.email
        && request.resource.data.criadoEm == request.time;
      allow update, delete: if false;
    }

    match /rate_limits/{documentId} {
      allow read, write: if false;
    }

    // Tetos de criacao por origem e por telefone: so as Functions leem e gravam.
    match /limites_origem/{documentId} {
      allow read, write: if false;
    }

    match /telefones_agendados/{documentId} {
      allow read, write: if false;
    }

    // Metricas de cada abertura: so contadores, sem dado pessoal. Gravadas
    // pelas Functions; o painel so le.
    match /metricas_abertura/{segunda}/fragmentos/{fragmento} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pedidos_avaliacao_google/{documentId} {
      allow read, write: if false;
    }

    match /destinatarios_avaliacao_google/{documentId} {
      allow read, write: if false;
    }

    match /configuracoes/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /credenciais_estacionamento/{documentId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
