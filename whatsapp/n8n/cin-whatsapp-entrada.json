      "id": "c2000000-0000-4000-8000-000000000002",
      "name": "Hash do segredo",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "action": "hash",
        "type": "SHA256",
