    {
      "id": "c2000000-0000-4000-8000-000000000011",
      "name": "Telefone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Why Code: mesma regra de telefoneWhatsApp em functions/whatsapp-cin.js (55 + DDD + nono digito).\nconst m = $('Ler mensagem').first().json;\nconst lid = $input.first().json || {};\nconst origem = m.ehLid ? String(lid.pn || lid.phoneNumber || '') : m.chatId;\nlet d = origem.split('@')[0].replace(/\\D/g, '');\nif (d.length > 11 && d.startsWith('55')) d = d.slice(2);\nif (d.length === 10 && /^[6-9]/.test(d.slice(2))) d = d.slice(0, 2) + '9' + d.slice(2);\nconst telefone = /^[1-9]{2}9\\d{8}$/.test(d) ? '55' + d : '';\nconst hoje = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });\nreturn [{ json: { ...m, telefone, chave: (telefone || m.chatId) + '_' + hoje, em: new Date().toISOString() } }];"
      }
