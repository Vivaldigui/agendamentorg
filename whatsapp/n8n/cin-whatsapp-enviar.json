          "responseCode": 200
        }
      }
    },
    {
      "id": "c1000000-0000-4000-8000-000000000016",
      "name": "Digitando",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -40
      ],
      "parameters": {
        "method": "POST",
        "url": "http://camara-itanhandu_waha-cin:3000/api/startTyping",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: 'cin', chatId: $('Conferir número no WhatsApp').first().json.chatId }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CinWahaKey000001",
          "name": "WAHA da CIN"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "c1000000-0000-4000-8000-000000000017",
      "name": "Esperar 3 a 6 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1760,
        -40
      ],
      "parameters": {
        "amount": "={{ 3 + Math.floor(Math.random() * 4) }}",
        "unit": "seconds"
      },
      "notes": "O intervalo entre mensagens fica na function (15 a 30 s). Aqui é só o \"digitando\".",
      "notesInFlow": true
    },
    {
      "id": "c1000000-0000-4000-8000-000000000018",
      "name": "Enviar pelo WAHA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -40
      ],
      "parameters": {
        "method": "POST",
        "url": "http://camara-itanhandu_waha-cin:3000/api/sendText",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: 'cin', chatId: $('Conferir número no WhatsApp').first().json.chatId, text: $('Receber pedido').first().json.body.texto, linkPreview: false }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CinWahaKey000001",
          "name": "WAHA da CIN"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "c1000000-0000-4000-8000-000000000019",
      "name": "Enviado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2200,
        -100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ enviado: true, mensagemId: ($json.id && typeof $json.id === 'object' ? ($json.id._serialized || $json.id.id || '') : ($json.id || ($json.key && $json.key.id) || '')) }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "c1000000-0000-4000-8000-000000000020",
      "name": "Falha no WAHA",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2200,
        140
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ erro: 'waha', detalhe: String(($json.error && ($json.error.message || JSON.stringify($json.error))) || 'sem detalhe').slice(0, 200) }) }}",
        "options": {
          "responseCode": 502
        }
      }
    }
