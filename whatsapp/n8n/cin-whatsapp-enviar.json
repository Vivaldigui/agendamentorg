{
  "id": "CinWhatsEnviar01",
  "name": "CIN — enviar aviso do agendamento pelo WhatsApp (WAHA)",
  "active": false,
  "nodes": [
    {
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Receber pedido",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cin-whatsapp-enviar",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "c1a0f6e2-5b7d-4c11-9a3e-7d2b8e4f1a01"
    },
    {
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Hash do token",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        220,
        200
      ],
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ String($json.headers['x-cin-token'] || '') }}",
        "dataPropertyName": "tokenHash",
        "encoding": "hex"
      }
    },
    {
      "id": "c1000000-0000-4000-8000-000000000006",
      "name": "Pedido válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000003",
              "leftValue": "={{ $json.tokenHash === 'ae1a8ec113ed84512e665216213c241ca6f65632bfd9937e92f19ee5c2159e12' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "c1000000-0000-4000-8000-000000000004",
              "leftValue": "={{ /^55\\d{10,11}$/.test(String($('Receber pedido').first().json.body.telefone || '')) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "c1000000-0000-4000-8000-000000000005",
              "leftValue": "={{ typeof $('Receber pedido').first().json.body.texto === 'string' && $('Receber pedido').first().json.body.texto.length > 0 && $('Receber pedido').first().json.body.texto.length <= 3000 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "Confere o hash do cabeçalho X-Cin-Token (o token fica só no Firebase) e o pedido.",
      "notesInFlow": true
    },
    {
      "id": "c1000000-0000-4000-8000-000000000007",
      "name": "Recusar pedido",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        360
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ erro: 'nao_autorizado' }) }}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "c1000000-0000-4000-8000-000000000008",
      "name": "Procurar na lista de saída",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        660,
        120
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "cin_whatsapp_saida"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "telefone",
              "keyValue": "={{ $('Receber pedido').first().json.body.telefone }}"
            }
          ]
        },
        "returnAll": true
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "c1000000-0000-4000-8000-000000000010",
      "name": "Saiu dos avisos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000009",
              "leftValue": "={{ $json.telefone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c1000000-0000-4000-8000-000000000011",
      "name": "Pessoa saiu",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        260
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ enviado: false, motivo: 'saiu' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "c1000000-0000-4000-8000-000000000012",
      "name": "Conferir número no WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        120
      ],
      "parameters": {
        "method": "GET",
        "url": "http://camara-itanhandu_waha-cin:3000/api/contacts/check-exists",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $('Receber pedido').first().json.body.telefone }}"
            },
            {
              "name": "session",
              "value": "cin"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CinWahaKey000001",
          "name": "WAHA da CIN"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "c1000000-0000-4000-8000-000000000014",
      "name": "Número tem WhatsApp?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        60
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000013",
              "leftValue": "={{ $json.numberExists }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c1000000-0000-4000-8000-000000000015",
      "name": "Sem WhatsApp",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ enviado: false, motivo: 'sem_whatsapp' }) }}",
