        "method": "GET",
        "url": "={{ $('Dados').first().json.waha_url }}/api/sessions/{{ $('Dados').first().json.sessao }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CinWahaKey000001",
          "name": "WAHA da CIN"
        }
