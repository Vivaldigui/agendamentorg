        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ ($('Dados').first().json.telefone_teste.replace(/\\D/g, '').length <= 11 ? '55' : '') + $('Dados').first().json.telefone_teste.replace(/\\D/g, '') }}"
            },
            {
              "name": "session",
              "value": "={{ $('Dados').first().json.sessao }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
